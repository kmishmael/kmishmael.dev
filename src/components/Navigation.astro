---
const NAV_LINKS = [
  {
    href: "/",
    label: "Home",
  },
  {
    href: "/blog",
    label: "Blog",
  },
  {
    href: "/about",
    label: "About",
  },
  {
    href: "/tags",
    label: "Tags",
  },
];
---

<div class="hidden md:flex flex-row gap-5">
  {
    NAV_LINKS.map((link) => (
      <a
        href={link.href}
        class="text-neutral-500 underline-offset-4 hover:text-black dark:text-neutral-400 dark:hover:text-neutral-200"
      >
        {link.label}
      </a>
    ))
  }
</div>
<div class="md:hidden">
  <button id="menu-toggle" class="text-gray-800 dark:text-gray-200">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="w-6 h-6"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
    </svg>
  </button>
  <div
    id="mobile-menu"
    class="hidden absolute top-16 left-0 right-0 bg-white dark:bg-dark-bg shadow-md py-2 px-4 flex flex-col gap-2"
  >
    <a
      class="block py-2 text-black dark:text-white hover:text-gray-900 dark:hover:text-gray-100"
      href="/">Home</a
    >
    <a
      class="block py-2 text-black dark:text-white hover:text-gray-900 dark:hover:text-gray-100"
      href="/blog">Blog</a
    >
    <a
      class="block py-2 text-black dark:text-white hover:text-gray-900 dark:hover:text-gray-100"
      href="/about">About</a
    >
    <a
      class="block py-2 text-black dark:text-white hover:text-gray-900 dark:hover:text-gray-100"
      href="/tags">Tags</a
    >
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");

    if (menuToggle && mobileMenu) {
      menuToggle.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
      });
    }
  });
</script>
